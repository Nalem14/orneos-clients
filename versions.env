# Official releases the Orneos clients are built from. scripts/check-upstream.sh bumps them;
# the build applies our branding on top of exactly these tags (no long-lived fork).
DESKTOP_TAG=v35.0.0
ANDROID_TAG=stable-35.0.1
TALK_TAG=v25.0.2
TALK_DESKTOP_TAG=v2.3.3
# Extra stable increment (last two digits of the Android versionCode, band 90–99) on top of the
# official tag. 0 keeps the official number. Raise by 1 when the overlay changes without a new tag,
# otherwise F-Droid and the updater keep the previous APK. check-upstream.sh resets it on a tag bump.
ANDROID_REVISION=2
TALK_REVISION=2
